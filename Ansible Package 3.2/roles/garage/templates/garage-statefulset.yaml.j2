apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: garage
  namespace: garage
  labels:
    app: garage
spec:
  serviceName: garage
  replicas: {{ garage_replicas }}
  selector:
    matchLabels:
      app: garage
  template:
    metadata:
      labels:
        app: garage
    spec:
      containers:
        - name: garage
          image: "{{ garage_image }}:{{ garage_version }}"
          command:
            - /garage
            - -c
            - /etc/garage/garage.toml
            - server
            - --single-node
            - --default-bucket
          env:
            - name: GARAGE_DEFAULT_ACCESS_KEY
              value: "{{ velero_s3_access_key }}"
            - name: GARAGE_DEFAULT_SECRET_KEY
              value: "{{ velero_s3_secret_key }}"
            - name: GARAGE_DEFAULT_BUCKET
              value: "{{ velero_bucket }}"
          ports:
            - containerPort: 3900
              name: s3-api
            - containerPort: 3901
              name: rpc
            - containerPort: 3902
              name: s3-web
            - containerPort: 3903
              name: admin
          volumeMounts:
            - name: data
              mountPath: /var/lib/garage/data
            - name: meta
              mountPath: /var/lib/garage/meta
            - name: config
              mountPath: /etc/garage
              readOnly: true
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
      volumes:
        - name: config
          secret:
            secretName: garage-config
            items:
              - key: garage-config.toml
                path: garage.toml
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: longhorn
        resources:
          requests:
            storage: {{ garage_storage_size }}
    - metadata:
        name: meta
      spec:
        accessModes: ["ReadWriteOnce"]
        storageClassName: longhorn
        resources:
          requests:
            storage: 2Gi
